# Mesmo valor público de VITE_NEON_URL. Use o branch de teste enquanto for prova de conceito.
NEON_URL=https://ep-exemplo.c-6.us-east-2.aws.neon.tech/magalhaes

# URL pública do endpoint /mcp. Deve ser idêntica ao "Server URL" do OAuth provider no Neon.
MCP_RESOURCE_URL=https://seu-dominio.exemplo.com/mcp

# Login taskflow_mcp criado por neon/mcp-role.sql (nunca a conexão do dono do banco).
MCP_DATABASE_URL=postgresql://taskflow_mcp:SENHA@ep-exemplo-pooler.c-6.us-east-2.aws.neon.tech/magalhaes?sslmode=verify-full

# Opcional: só se o issuer do branch não seguir o padrão derivado de NEON_URL.
# NEON_AUTH_BASE_URL=

PORT=8787
